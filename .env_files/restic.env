# B2 credentials for restic. Resolved from the keychain on every shell start; also
# consumed by resticprofile via dot_config/resticprofile/executable_get_env.sh.tmpl.
# AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY are mirrored for S3 compatible B2 API
export B2_ACCOUNT_ID=$(security find-generic-password -a burningham-backups-restic -s B2_ACCOUNT_ID -w)
export B2_ACCOUNT_KEY=$(security find-generic-password -a burningham-backups-restic -s B2_ACCOUNT_KEY -w)

export RESTIC_PASSWORD_COMMAND="security find-generic-password -a burningham-backups-restic -s RESTIC_PASSWORD -w"
export RESTIC_REPOSITORY=$(security find-generic-password -a burningham-backups-restic -s RESTIC_REPOSITORY -w)
