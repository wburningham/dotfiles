#!/bin/sh
# shellcheck disable=SC1083
# run_onchange_rulesync.sh.tmpl (chezmoi template)
set -e

# Trigger re-run when rulesync config or source files change (via hash in comment).
# rulesync.jsonc: {{ include "rulesync.jsonc" | sha256sum }}
# rulesync.lock: {{ include "rulesync.lock" | sha256sum }}
# permissions.json: {{ include (joinPath .chezmoi.sourceDir "exact_dot_rulesync/permissions.json") | sha256sum }}
# {{ range $path := glob (joinPath .chezmoi.sourceDir "exact_dot_rulesync/**") }}
# {{ if and (eq (stat $path).type "file") (ne (base $path) ".DS_Store") }}
# {{ $path }}: {{ include $path | sha256sum }}
# {{ end }}
# {{ end }}

if ! command -v rulesync >/dev/null 2>&1; then
  echo "chezmoi: warning: rulesync not found on PATH, skipping" >&2
  exit 0
fi

cd {{ .chezmoi.homeDir | quote }}

# Declarative sources in rulesync.jsonc fetch into ~/.rulesync/skills/.curated/
# (and ~/.rulesync/rules/.curated/). generate reads those trees but does not
# fetch; install must run first.
#
# Wipe .curated/ before install: plain install can report "up to date" when a
# partial stale tree remains even though rulesync.lock points at a new commit.
# --frozen fetches at the lock-pinned refs without rewriting rulesync.lock
# (chezmoi owns the lock file in source).
rm -rf .rulesync/skills/.curated .rulesync/rules/.curated
rulesync install --frozen

# Cursor rules: project-scope generate from ~ writes ~/.cursor/rules/*.mdc.
# rulesync global mode does not support Cursor rules generation.
rulesync generate --targets cursor --features rules,skills

# Permissions: chezmoi deploys exact_dot_rulesync/permissions.json to
# ~/.rulesync/permissions.json before this onchange script runs. Pass 2 reads
# that file and writes ~/.claude/settings.json, ~/.cursor/cli-config.json, and
# ~/.codex/config.toml. --global is required; project scope writes cli.json.
if [ ! -f .rulesync/permissions.json ]; then
  echo "chezmoi: warning: .rulesync/permissions.json missing, skipping permissions generate" >&2
else
  rulesync generate --global --features permissions
fi

# Claude Code + Codex rules: user-scope only; handled here since pass 1 is cursor-only.
rulesync generate --global --targets claudecode,codexcli --features rules,skills

# MCP: global Claude Code (~/.claude.json) and Cursor (~/.cursor/mcp.json).
if [ ! -f .rulesync/mcp.json ]; then
  echo "chezmoi: warning: .rulesync/mcp.json missing, skipping mcp generate" >&2
else
  rulesync generate --global --features mcp
fi

# generate --delete sweeps orphaned files but leaves empty directories (ex: scripts/
# removed from upstream but the dir remains). Prune empties under skill outputs.
for skill_root in .cursor/skills .claude/skills .agents/skills; do
  if [ -d "$skill_root" ]; then
    find "$skill_root" -depth -type d -empty -delete 2>/dev/null || true
  fi
done
