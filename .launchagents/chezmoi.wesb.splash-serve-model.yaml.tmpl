# Serves mlx-community/Qwen3.6-35B-A3B-4bit at http://127.0.0.1:8000 by default.
# After Ready: splash opencode, or open the web UI in a browser on this Mac.

Label: chezmoi.wesb.splash-serve-model
UserName: wesb
StandardOutPath: /tmp/splash-serve-model.out.log
StandardErrorPath: /tmp/splash-serve-model.err.log
ProgramArguments:
  - /opt/homebrew/bin/splash
  - serve
  - --model
  - mlx-community/Qwen3.6-35B-A3B-4bit
RunAtLoad: true
KeepAlive: true
