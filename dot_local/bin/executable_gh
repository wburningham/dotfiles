#!/bin/sh
# Wrap Homebrew's gh to default GH_HOST to the local read-only GitHub proxy
# (see .launchagents/chezmoi.wesb.readonly-dev-proxy.yaml.tmpl). Set GH_HOST to override.
#
# Agent sandboxes block reading shell init files, so GH_HOST from .env_files/github.env
# never reaches them. Setting it here works because ~/.local/bin precedes Homebrew on PATH.
GH_HOST=${GH_HOST:-127.0.0.1:9443} exec /opt/homebrew/bin/gh "$@"
