//
// Zed settings
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "excerpt_context_lines": 4,
  "diff_view_style": "unified",
  "cli_default_open_behavior": "new_window", // so 'zed .' opens a new window rather than a dir in an existing one
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "raw.githubusercontent.com"
      ]
    },
    "tool_permissions": {
      "tools": {
        "write_file": {
          "default": "allow"
        },
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com"
            }
          ]
        },
        "skill": {
          "default": "allow"
        },
        "terminal": {
          "always_allow": [
            {
              "pattern": "^cd\\s+/Users/wesb/code/go/src/github\\.com/wburningham/ledger(\\s|$)"
            },
            {
              "pattern": "^python\\b"
            },
            {
              "pattern": "^uv\\s+pip(\\s|$)"
            },
            {
              "pattern": "^ls\\b"
            },
            {
              "pattern": "^find\\s+\\.venv(\\s|$)"
            },
            {
              "pattern": "^find\\s+\\.(\\s|$)"
            },
            {
              "pattern": "^grep\\b"
            },
            {
              "pattern": "^head\\b"
            },
            {
              "pattern": "^python3\\s+tmp_parse_csv\\.py(\\s|$)"
            },
            {
              "pattern": "^bean-check\\s+beans/main\\.beancount(\\s|$)"
            },
            {
              "pattern": "^python3\\s+tmp_fix_legacy\\.py(\\s|$)"
            },
            {
              "pattern": "^python3\\s+tmp_fix_legacy2\\.py(\\s|$)"
            },
            {
              "pattern": "^rm\\s+tmp_parse_csv\\.py(\\s|$)"
            },
            {
              "pattern": "^python3\\s+tmp_complete_legacy\\.py(\\s|$)"
            },
            {
              "pattern": "^rm\\s+tmp_complete_legacy\\.py(\\s|$)"
            },
            {
              "pattern": "^which\\s+rledger(\\s|$)"
            },
            {
              "pattern": "^echo\\s+not(\\s|$)"
            },
            {
              "pattern": "^which\\s+bd(\\s|$)"
            },
            {
              "pattern": "^echo\\s+bd(\\s|$)"
            },
            {
              "pattern": "^rledger\\b"
            }
          ]
        },
        "create_directory": {
          "default": "allow"
        }
      }
    },
    "default_profile": "write",
    "threads_sidebar": {
      "position": "right"
    },
    "use_modifier_to_send": true,
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "splash",
      "model": "mlx-community/Qwen3.6-35B-A3B-4bit"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "inline_code_actions": true,
  "colorize_brackets": true,
  "indent_guides": {
    "enabled": true
  },
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "collaboration_mode": "default",
        "mode": "agent",
        "reasoning_effort": "medium",
        "model": "gpt-5.6-terra"
      },
      "type": "registry"
    },
    "claude-acp": {
      "favorite_config_option_values": {
        "effort": [
          "xhigh"
        ]
      },
      "default_config_options": {
        "effort": "medium",
        "model": "sonnet",
        "mode": "acceptEdits"
      },
      "type": "registry"
    },
    "cursor": {
      "default_config_options": {
        "mode": "agent",
        "model": "composer-2[fast=true]"
      },
      "type": "registry"
    }
  },
  "language_models": {
    "openai_compatible": {
      "splash": {
        "api_url": "http://127.0.0.1:8000/v1",
        "available_models": [
          {
            "name": "mlx-community/Qwen3.6-35B-A3B-4bit",
            "max_tokens": 262144,
            "max_output_tokens": 65536,
            "max_completion_tokens": 65536,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": true,
              "max_tokens_parameter": false
            }
          }
        ]
      }
    }
  },
  "edit_predictions": {
    "provider": "zed",
    "open_ai_compatible_api": {
      "api_url": "http://localhost:8000",
      "model": "mlx-community/Qwen3.6-35B-A3B-4bit",
      "prompt_format": "qwen",
      "max_output_tokens": 128
    }
  },
  "use_system_window_tabs": true, // Allow windows to tab together based macOS setting
  "file_types": {
    "YAML": [
      "*.yaml.tmpl"
    ], // enable YAML parsing chezmoi .yaml.tmpl files
    "JSON": [
      "*.qsf"
    ], // enable JSON parsing survey .qsf files
    "JSONC": [
      "private_settings.json"
    ],
    "Shell Script": [
      ".envrc",
      ".envrc.local"
    ],
    "Git Attributes": [
      "**/{git,.git,.git/info}/attributes"
    ],
    "Git Config": [
      "*.gitconfig",
      "**/{git,.git/modules,.git/modules/*}/config"
    ],
    "Git Ignore": [
      "**/{git,.git}/ignore",
      "**/.git/info/exclude"
    ]
  },
  "lsp": {
    "typos": {
      "initialization_options": {
        // Path to your typos config file, .typos.toml by default.
        "config": "~/.typos.toml"
      }
    },
    "gopls": {
      "initialization_options": {
        "gofumpt": true
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy"
        }
      }
    },
    "biome": {
      "settings": {
        "json": {
          "parser": {
            "allowTrailingCommas": true
          }
        }
      }
    },
    "vale": {
      "binary": {
        "env": {
          "VALE_STYLES_PATH": "/Users/wesb/.vale-styles"
        }
      },
      // These initialization options are merged into Zed's defaults
      "initialization_options": {
        "installVale": false,
        // "configPath": "",	// An absolute path to a .vale.ini file to be used as the default configuration.
        "syncOnStartup": true // Runs vale sync upon starting the server.
      }
    }
  },
  "languages": {
    "Go": {
      "format_on_save": "on",
      "formatter": "language_server",
      "code_actions_on_format": {
        "source.organizeImports": true
      }
    },
    "Groovy": {
      "enable_language_server": false
    },
    "Git Commit": {
      "show_wrap_guides": true,
      // Conventional commit line length guides
      "wrap_guides": [
        52,
        72
      ]
    },
    "JSONC": {
      "language_servers": [
        "json-language-server",
        "!biome",
        "..."
      ],
      "formatter": "language_server"
    }
  },
  // The name of a font to use in the UI
  // "ui_font_family": "Maple Mono",
  // The name of a font to use for rendering text in the buffer/terminal
  "buffer_font_family": "Maple Mono",
  // Set the buffer/terminal text's font fallbacks, this will be merged with
  // the platform's default fallbacks.
  "buffer_font_fallbacks": [
    "Maple Mono"
  ],
  "terminal": {
    "font_family": "FiraCode Nerd Font Mono"
  },
  "base_keymap": "SublimeText",
  "telemetry": {
    // Send debug info like crash reports.
    "diagnostics": false,
    // Send anonymized usage data like what languages you're using Zed with.
    "metrics": false
  },
  "ui_font_size": 17,
  "buffer_font_size": 17,
  "auto_install_extensions": {
    "biome": true,
    "cue": true,
    "dockerfile": true,
    "fish": true,
    "git-firefly": true,
    "groovy": true,
    "html": true,
    "java": true,
    "json5": true,
    "ktrz-monokai": true,
    "php": true,
    "ruby": true,
    "sql": true,
    "svelte": true,
    "toml": true,
    "txtar": true,
    "typos": true,
    "vale": true
  },
  "theme": {
    "mode": "dark",
    "light": "KTRZ Monokai",
    "dark": "One Dark"
  }
}
