	{
		"bindings": {
			"cmd-i": "agent::ToggleFocus"
		}
	},
	{
		// `agent::AllowAlways` is only handled inside the thread view, so focus
		// the panel (cmd-i, above) and replay `y y` there. Heads up: a global
		// `y y` swallows `y` in editors, terminals, and pickers.
		"context": "!AcpThread",
		"bindings": {
			"y y": ["workspace::SendKeystrokes", "cmd-i y y"]
		}
	},
	{
		"context": "AcpThread",
		"bindings": {
			"y y": "agent::AllowAlways"
		}
	},
	{
		"context": "Terminal",
		"bindings": {
			"cmd-up": ["terminal::SendText", "\u001bgg"],
			"cmd-down": ["terminal::SendText", "\u001bG"]
		}
	}
]
